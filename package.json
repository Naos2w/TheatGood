{
  "name": "theatgood",
  "version": "0.1.0",
  "description": "Taiwan cinema 3D seat-view preview and viewing history",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "schema:generate": "node --experimental-strip-types scripts/generate-auditorium-schema.mjs && prettier --write public/schemas/auditorium-v1.schema.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx db/seed.ts",
    "db:seed:fixture": "tsx db/seed-fixture.ts",
    "db:screenings:sync": "tsx scripts/sync-screenings.ts",
    "db:verify": "tsx db/verify.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Naos2w/TheatGood.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Naos2w/TheatGood/issues"
  },
  "homepage": "https://github.com/Naos2w/TheatGood#readme",
  "private": true,
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@neondatabase/neon-js": "^0.9.0-beta",
    "@tresjs/cientos": "^5.11.0",
    "@tresjs/core": "^5.11.0",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "pinia": "^4.1.0",
    "three": "^0.187.0",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.20",
    "vue-router": "^5.5.1",
    "vuetify": "^3.13.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.5.1",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}

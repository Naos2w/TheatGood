# The 2D / 3D viewer runs without a database. Backend commands only:
# Copy this file to .env and populate the URL from the Neon develop branch.
# NEVER prefix DATABASE_URL with VITE_; Vite would publish it to the browser.
VITE_APP_NAME=TheatGood
# Optional branch-specific PUBLIC endpoint URLs for future opt-in cloud history.
# These are NOT secrets and do not enable a private API unless Auth + RLS are configured.
# Never mix Auth and Data API from different Neon branches.
VITE_NEON_AUTH_URL=
VITE_NEON_DATA_API_URL=
DATABASE_URL=
# Optional non-secret Neon project / branch IDs for operator reference:
NEON_PROJECT_ID=
NEON_DEV_BRANCH_ID=
NEON_PROD_BRANCH_ID=
